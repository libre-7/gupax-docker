# =============================================================================
# Gupax-docker .dockerignore
# =============================================================================

# Git
.git
.gitignore

# Documentation
README.md
LICENSE
docs/

# Docker
docker-compose.yml
docker-compose*.yml
.dockerignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets and local config — these must never enter the build context
.env
.env.*

# Remaining markdown (CHANGELOG, SECURITY, CONTRIBUTING, TODO, templates/)
*.md
