# =============================================================================
# Gupax-docker .dockerignore
# =============================================================================

# Git
.git
.gitignore

# Documentation and non-build inputs
README.md
LICENSE

# Docker
docker-compose.yml
docker-compose*.yml
.dockerignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Secrets and local config — these must never enter the build context
.env
.env.*

# Remaining markdown at the repository root (CHANGELOG, SECURITY, CONTRIBUTING,
# TODO). templates/ is excluded by the same rule; its XML is a distribution
# artifact, not a build input.
*.md
