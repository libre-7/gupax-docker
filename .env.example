# =============================================================================
# Gupax-docker Environment Variables
# Copy this file to .env and uncomment values you want to customize.
# All variables have sensible defaults — the container works out of the box.
# =============================================================================

# --- Tor ---

# Start the Tor daemon (SOCKS5 127.0.0.1:9050) and an .onion hidden service.
# Nothing is routed through Tor by this flag alone: set monerod's arguments to
#   --tx-proxy=tor,127.0.0.1:9050
# inside Gupax (Node -> Arguments) to send transactions through it.
# P2P sync stays on clearnet by design.
# Default: false
# TOR_ENABLED=false

# Publish monerod wallet RPC (18081) on the .onion hidden service.
# Off by default: monerod RPC is unauthenticated unless you paste
# --restricted-rpc into Gupax, so exposing it hands admin RPC to anyone who
# learns the .onion.
# Default: false
# TOR_EXPOSE_RPC=false

# --- VNC Security ---

# Require a password for VNC/noVNC access.
# VNC authentication uses a fixed 8-byte key, so only the FIRST 8 characters
# are effective; longer values are truncated by the protocol (start.sh warns).
# Leave empty for no authentication — x11vnc then listens on loopback only, so
# noVNC still works but publishing port 5900 does not expose the desktop.
# Default: empty
# VNC_AUTH_TOKEN=

# --- Monero Node ---

# Adds --restricted-rpc to the monerod arguments the container RECOMMENDS at
# startup. It is not enforced: Gupax launches monerod with whatever is in its
# own Node -> Arguments box, so you must paste and Save them there yourself.
# With this set to false, the startup banner warns that port 18081 is then
# reachable without authentication.
# Default: true
# MONERO_RPC_RESTRICTED=true

# --- File Permissions ---

# User/group ID for volume ownership. If unset, the container detects the
# owner of the gupax-data volume and falls back to 999 (the image's miner
# user) for a fresh root-owned volume. docker-compose.yml explicitly defaults
# these to 999; the Unraid template defaults to 99:100.
# PUID=99
# PGID=100

# --- Display ---

# Resolution for the virtual X display running Gupax.
# Default: 1920x1080x24
# SCREEN_RESOLUTION=1920x1080x24

# --- Blockchain ---

# Optional: host path or named volume containing an existing Monero blockchain.
# If empty, defaults to a named volume 'gupax-monero'.
# MONERO_DATA_PATH=

# =============================================================================
# ACCESSING THE GUI
# =============================================================================
#
# This container is self-contained with noVNC.
# Simply open your web browser to:
#
#   http://localhost:6080
#
# Click "Connect" to access the Gupax GUI.
#
# NOTE: To use an existing blockchain, set MONERO_DATA_PATH above
# and in Gupax UI, go to Node tab and set the database path to:
#   /home/miner/.bitmonero
#
# NOTE: Your Monero wallet address (where mining payouts are sent) is set in
# the Gupax GUI under the P2Pool tab, "Monero Address" field.
# =============================================================================
